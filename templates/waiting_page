    <script>
      // Firebase configuration
const firebaseConfig = {
    apiKey: "AIzaSyDutZ9Ue_wOmtvXUHrJuWuTplCFGfrvoLM",
    authDomain: "fypautoml.firebaseapp.com",
    projectId: "fypautoml",
    storageBucket: "fypautoml.firebasestorage.app",
    messagingSenderId: "945914686130",
    appId: "1:945914686130:web:ea30eab865086e1bff77ab",
    measurementId: "G-D0XJLZ2HXX"
};

// Initialize Firebase
firebase.initializeApp(firebaseConfig);
const firestore = firebase.firestore();
const auth = firebase.auth();

// Timer functionality
let timeElapsed = 0;
const timerElement = document.getElementById('elapsed-time');

function formatTime(seconds) {
    const mins = Math.floor(seconds / 60);
    const secs = seconds % 60;
    return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
}

function updateTimer() {
    timeElapsed++;
    timerElement.textContent = formatTime(timeElapsed);
}

// Start the timer
setInterval(updateTimer, 1000);

// Main status logic
  firebase.auth().onAuthStateChanged((user) => {
    if (user) {
      const userRef = firestore.collection('Users').doc(user.uid);
      userRef.onSnapshot((doc) => {
        if (doc.exists) {
          const status = doc.data().status;
          switch (status) {
            case 'approved':
              showApprovalState();
              setTimeout(() => {
                window.location.href = '/index';
              }, 2000);
              break;
            case 'pending':
              window.location.href = '/select_license';
              break;
            case 'rejected':
              showRejectedMessage();
              setTimeout(() => {
                window.location.href = '/upload_receipt';
              }, 4000);
              break;
            case 'waiting_review':
            default:
              // Stay on the page
              break;
          }
        }
      });
    } else {
      window.location.href = '/';
    }
  });

function showApprovalState() {
    const container = document.querySelector('.status-container');
    container.innerHTML = `
        <div class="file-check-icon" style="background: var(--green-100);">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--green-500);">
                <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                <path d="m9 12 2 2 4-4"></path>
            </svg>
        </div>
        <h1>Receipt Approved!</h1>
        <p style="color: var(--gray-600);">Your receipt has been approved. Redirecting you now...</p>
        <div class="progress-indicator">
            <div class="spinner"></div>
        </div>
    `;
}

